# Cross-device sync (optional). Copy this file to `.env.local` and fill in the
# two values from your Supabase project: Settings → API.
#
# Without these the app still works perfectly — data just stays on each device
# (no sync). With them, devices that enter the same passphrase share data.
# Both values are safe to expose in the client (the anon key is public by design).
#
# After setting them locally, restart `npm run dev`. For production, add the same
# two variables in your host's env settings (Vercel/Netlify) and redeploy.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
