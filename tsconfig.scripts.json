{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "outDir": ".scripts-build",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/screener/**/*.ts",
    "scripts/screener/**/*.ts"
  ]
}
