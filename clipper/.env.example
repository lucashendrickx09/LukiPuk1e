# Secrets for the YouTube -> Short-Form Clipper.
# Copy to `.env` and fill in. NEVER commit `.env`.
#
#   cp .env.example .env
#
# Each key is only required by the phase that uses it (see comments).

# Phase 3 — Claude highlight selection (required once you reach Phase 3)
ANTHROPIC_API_KEY=

# Phase 5 — Postiz self-hosted posting backend
POSTIZ_API_KEY=

# Phase 6 — Telegram approval bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — only if you opt into these in config.yaml (paid_apis:)
AYRSHARE_API_KEY=
OPENAI_API_KEY=
